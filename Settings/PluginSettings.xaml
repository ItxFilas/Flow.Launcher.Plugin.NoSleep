<UserControl x:Class="Flow.Launcher.Plugin.NoSleep.Settings.PluginSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="460" d:DesignWidth="420">
    <ScrollViewer Margin="{StaticResource SettingPanelMargin}"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel VerticalAlignment="Top">
            <CheckBox x:Name="StartWithFlowLauncherCheckBox"
                      VerticalAlignment="Center"
                      Margin="0,8,0,8"
                      Checked="StartWithFlowLauncherCheckBox_Changed"
                      Unchecked="StartWithFlowLauncherCheckBox_Changed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE7E8;"
                               FontSize="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="Start nosleep service when Flow Launcher starts"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="SendNotificationsCheckBox"
                      VerticalAlignment="Center"
                      Margin="0,8,0,8"
                      Checked="SendNotificationsCheckBox_Changed"
                      Unchecked="SendNotificationsCheckBox_Changed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE7E7;"
                               FontSize="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="Send notifications when nosleep starts/stops"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="ShowTrayIconCheckBox"
                      VerticalAlignment="Center"
                      Margin="0,8,0,8"
                      Checked="ShowTrayIconCheckBox_Changed"
                      Unchecked="ShowTrayIconCheckBox_Changed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE7C4;"
                               FontSize="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="Show tray icon when nosleep is active"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="KeepDisplayAwakeCheckBox"
                      VerticalAlignment="Center"
                      Margin="0,8,0,8"
                      Checked="KeepDisplayAwakeCheckBox_Changed"
                      Unchecked="KeepDisplayAwakeCheckBox_Changed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE7F4;"
                               FontSize="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="Keep display awake while nosleep is active"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="DisableOnLowBatteryCheckBox"
                      VerticalAlignment="Center"
                      Margin="0,8,0,4"
                      Checked="DisableOnLowBatteryCheckBox_Changed"
                      Unchecked="DisableOnLowBatteryCheckBox_Changed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xEBAA;"
                               FontSize="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="Turn off nosleep on low battery"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <StackPanel Orientation="Horizontal"
                        Margin="24,0,0,8"
                        VerticalAlignment="Center">
                <TextBlock Text="Low battery threshold"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="LowBatteryThresholdTextBox"
                         Width="52"
                         Margin="8,0,4,0"
                         TextChanged="LowBatteryThresholdTextBox_Changed"/>
                <TextBlock Text="%"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <CheckBox x:Name="PluggedInOnlyCheckBox"
                      VerticalAlignment="Center"
                      Margin="0,8,0,8"
                      Checked="PluggedInOnlyCheckBox_Changed"
                      Unchecked="PluggedInOnlyCheckBox_Changed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE945;"
                               FontSize="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="Only run nosleep while plugged in"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="StopOnSessionLockCheckBox"
                      VerticalAlignment="Center"
                      Margin="0,8,0,8"
                      Checked="StopOnSessionLockCheckBox_Changed"
                      Unchecked="StopOnSessionLockCheckBox_Changed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE72E;"
                               FontSize="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="Turn off nosleep when Windows locks"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
